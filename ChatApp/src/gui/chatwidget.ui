  <property name="styleSheet">
   <string notr="true">QWidget#ChatWidget {
    background-color: #f5f5f5;
}
QListWidget {
    border: none;
    background-color: #f5f5f5;
    outline: none;
    font-size: 14px;
}
QListWidget::item {
    border: none;
    padding: 0px;
    margin: 5px;
}
QListWidget::item:selected {
    background-color: transparent;
}
QTextEdit {
    border: 1px solid #ddd;
    border-radius: 4px;
    padding: 10px;
    font-size: 14px;
    background-color: white;
}
QTextEdit:focus {
    border: 1px solid #4a90e2;
    outline: none;
}
QPushButton {
    border: none;
    border-radius: 4px;
    padding: 8px 12px;
    font-size: 13px;
    cursor: pointer;
}
QPushButton#btnSend {
    background-color: #4a90e2;
    color: white;
    font-weight: bold;
}
QPushButton#btnSend:hover {
    background-color: #3a7bc8;
}
QPushButton#btnSend:pressed {
    background-color: #2a6bb8;
}
QPushButton#btnSend:disabled {
    background-color: #cccccc;
    color: #666666;
}
QPushButton#btnFile, QPushButton#btnEmoji, QPushButton#btnHistory {
    background-color: #f0f0f0;
    color: #666;
    border: 1px solid #ddd;
}
QPushButton#btnFile:hover, QPushButton#btnEmoji:hover, QPushButton#btnHistory:hover {
    background-color: #e0e0e0;
}
QPushButton#btnFile:pressed, QPushButton#btnEmoji:pressed, QPushButton#btnHistory:pressed {
    background-color: #d0d0d0;
}
QLabel {
    font-size: 14px;
    color: #333;
}
QLabel#chatTitleLabel {
    font-weight: bold;
    font-size: 16px;
}
QLabel#chatStatusLabel {
    color: #666;
    font-size: 12px;
}
QToolButton {
    border: none;
    background-color: transparent;
    padding: 8px;
    border-radius: 4px;
}
QToolButton:hover {
    background-color: #f0f0f0;
}
QToolButton:pressed {
    background-color: #e0e0e0;
}
QToolButton#btnClose {
    color: #ff5252;
}
QToolButton#btnMinimize {
    color: #666;
}
QScrollBar:vertical {
    border: none;
    background-color: #f0f0f0;
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background-color: #c0c0c0;
    border-radius: 5px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background-color: #a0a0a0;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal {
    border: none;
    background-color: #f0f0f0;
    height: 10px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background-color: #c0c0c0;
    border-radius: 5px;
    min-width: 20px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #a0a0a0;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}</string>
